# OpenKore — Ubuntu 24.04 Setup & Runner
# ─────────────────────────────────────────
# Penggunaan:
#   make -f Makefile.ubuntu              → install + build + jalankan
#   make -f Makefile.ubuntu install      → install dependensi saja
#   make -f Makefile.ubuntu build        → compile XSTools saja
#   make -f Makefile.ubuntu run          → jalankan foreground
#   make -f Makefile.ubuntu start        → jalankan di background (screen)
#   make -f Makefile.ubuntu attach       → lihat log bot
#   make -f Makefile.ubuntu stop         → hentikan bot
#   make -f Makefile.ubuntu status       → cek status
#   make -f Makefile.ubuntu clean        → hapus hasil compile
#   make -f Makefile.ubuntu help         → tampilkan bantuan

SHELL        := /bin/bash
SCREEN_NAME  := openkore
PERL         := perl
PYTHON       := python3
SCONS        := $(PYTHON) src/scons-local-3.1.2/scons.py
MAIN         := openkore.pl
IFACE        := Console

R := \033[0;31m
G := \033[0;32m
Y := \033[1;33m
B := \033[1;34m
N := \033[0m

.PHONY: all install install-apt install-cpan build run start attach stop status clean help

# ── Default ─────────────────────────────────────────────────────────────────
all: install build start

# ── Dependensi ───────────────────────────────────────────────────────────────
install: install-apt install-cpan
	@echo -e "$(G)[+] Setup lengkap. Jalankan: make -f Makefile.ubuntu start$(N)"

install-apt:
	@echo -e "$(Y)[*] Install paket sistem...$(N)"
	@sudo apt-get update -qq
	@sudo apt-get install -y \
		perl perl-modules \
		python3 \
		build-essential \
		libssl-dev \
		zlib1g-dev \
		libreadline-dev \
		screen \
		cpanminus \
		libperlio-gzip-perl \
		libio-socket-ssl-perl \
		libnet-ssleay-perl \
		libcrypt-des-perl \
		libdigest-md5-perl \
		libdigest-sha-perl \
		liblist-moreutils-perl \
		libencode-perl \
		libio-compress-perl \
		liburi-perl \
		libwww-perl \
		libxml-libxml-perl
	@echo -e "$(G)[+] Paket apt selesai.$(N)"

install-cpan:
	@echo -e "$(Y)[*] Install modul Perl via cpanm...$(N)"
	@sudo cpanm --notest --quiet \
		List::MoreUtils \
		Time::HiRes \
		Compress::Zlib \
		IO::Socket::SSL \
		Net::SSLeay \
		Crypt::DES \
		Digest::MD5 \
		Digest::SHA \
		Encode \
		URI \
		LWP::UserAgent \
		JSON::XS \
		Math::BigInt
	@echo -e "$(G)[+] Modul CPAN selesai.$(N)"

# ── Build XSTools ─────────────────────────────────────────────────────────────
build:
	@echo -e "$(Y)[*] Mengcompile XSTools dengan SCons lokal...$(N)"
	@if [ ! -f src/scons-local-3.1.2/scons.py ]; then \
		echo -e "$(R)[-] scons.py tidak ditemukan. Pastikan direktori project lengkap.$(N)"; \
		exit 1; \
	fi
	$(SCONS)
	@if ls src/auto/XSTools/*.so 1>/dev/null 2>&1; then \
		echo -e "$(G)[+] XSTools berhasil di-compile: $$(ls src/auto/XSTools/*.so)$(N)"; \
	else \
		echo -e "$(R)[-] XSTools.so tidak terbuat. Lihat error di atas.$(N)"; \
		exit 1; \
	fi

# ── Jalankan foreground ───────────────────────────────────────────────────────
run:
	$(PERL) $(MAIN) --interface=$(IFACE)

# ── Jalankan di background (screen) ──────────────────────────────────────────
start:
	@if screen -list 2>/dev/null | grep -q "$(SCREEN_NAME)"; then \
		echo -e "$(Y)[!] Bot sudah berjalan di screen '$(SCREEN_NAME)'.$(N)"; \
		echo -e "    Lihat log : make -f Makefile.ubuntu attach"; \
		echo -e "    Hentikan  : make -f Makefile.ubuntu stop"; \
	else \
		screen -dmS $(SCREEN_NAME) $(PERL) $(MAIN) --interface=$(IFACE); \
		sleep 1; \
		if screen -list 2>/dev/null | grep -q "$(SCREEN_NAME)"; then \
			echo -e "$(G)[+] Bot berjalan di background (screen: $(SCREEN_NAME)).$(N)"; \
			echo -e "$(B)"; \
			echo -e "  Lihat log  : make -f Makefile.ubuntu attach"; \
			echo -e "  Keluar log : Ctrl+A lalu D  (bot tetap jalan)"; \
			echo -e "  Hentikan   : make -f Makefile.ubuntu stop$(N)"; \
		else \
			echo -e "$(R)[-] Gagal start. Coba: make -f Makefile.ubuntu run$(N)"; \
		fi \
	fi

# ── Attach ke screen ─────────────────────────────────────────────────────────
attach:
	@if screen -list 2>/dev/null | grep -q "$(SCREEN_NAME)"; then \
		screen -r $(SCREEN_NAME); \
	else \
		echo -e "$(R)[!] Session '$(SCREEN_NAME)' tidak aktif.$(N)"; \
	fi

# ── Stop ─────────────────────────────────────────────────────────────────────
stop:
	@if screen -list 2>/dev/null | grep -q "$(SCREEN_NAME)"; then \
		screen -S $(SCREEN_NAME) -X quit; \
		echo -e "$(G)[+] Bot dihentikan.$(N)"; \
	else \
		echo -e "$(Y)[!] Tidak ada session '$(SCREEN_NAME)' yang berjalan.$(N)"; \
	fi

# ── Status ────────────────────────────────────────────────────────────────────
status:
	@if screen -list 2>/dev/null | grep -q "$(SCREEN_NAME)"; then \
		echo -e "$(G)[+] Bot BERJALAN$(N)"; \
		screen -list | grep "$(SCREEN_NAME)"; \
	else \
		echo -e "$(R)[-] Bot TIDAK berjalan$(N)"; \
	fi

# ── Clean ─────────────────────────────────────────────────────────────────────
clean:
	@echo -e "$(Y)[*] Membersihkan hasil build...$(N)"
	@$(SCONS) -c 2>/dev/null || true
	@rm -f src/auto/XSTools/*.so src/auto/XSTools/*.o 2>/dev/null || true
	@echo -e "$(G)[+] Clean selesai.$(N)"

# ── Help ──────────────────────────────────────────────────────────────────────
help:
	@echo ""
	@echo -e "$(B)OpenKore — Ubuntu 24.04$(N)"
	@echo "─────────────────────────────────────────────"
	@echo "  make -f Makefile.ubuntu           install + build + start"
	@echo "  make -f Makefile.ubuntu install   install semua dependensi"
	@echo "  make -f Makefile.ubuntu build     compile XSTools"
	@echo "  make -f Makefile.ubuntu run       jalankan foreground (debug)"
	@echo "  make -f Makefile.ubuntu start     jalankan background (screen)"
	@echo "  make -f Makefile.ubuntu attach    lihat log  [Ctrl+A D = detach]"
	@echo "  make -f Makefile.ubuntu stop      hentikan bot"
	@echo "  make -f Makefile.ubuntu status    cek apakah bot berjalan"
	@echo "  make -f Makefile.ubuntu clean     hapus file hasil compile"
	@echo ""
